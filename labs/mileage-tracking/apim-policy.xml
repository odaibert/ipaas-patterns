<policies>
    <inbound>
        <base />
        <!-- Rate limiting: 5 calls per 60 seconds per IP -->
        <rate-limit calls="5" renewal-period="60" />
        <!-- Set content type -->
        <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
        </set-header>
        <!-- Rewrite backend URL to Logic App -->
        <set-backend-service base-url="{{LogicAppCallbackUrl}}" />
        <rewrite-uri template="/" copy-unmatched-params="false" />
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
        <!-- Add correlation headers -->
        <set-header name="X-Correlation-Id" exists-action="override">
            <value>@(context.RequestId.ToString())</value>
        </set-header>
    </outbound>
    <on-error>
        <base />
        <return-response>
            <set-status code="500" reason="Internal Server Error" />
            <set-header name="Content-Type" exists-action="override">
                <value>application/json</value>
            </set-header>
            <set-body>@{
                return new JObject(
                    new JProperty("error", new JObject(
                        new JProperty("code", context.LastError.Source),
                        new JProperty("message", context.LastError.Message)
                    ))
                ).ToString();
            }</set-body>
        </return-response>
    </on-error>
</policies>
